{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "catppuccin-macchiato"
  },
  "keybinds": {
    "app.exit": "<leader>d",
    "input.move.up": "ctrl+k",
    "input.move.down": "ctrl+j",
    "input.newline": "return",
    "input.submit": "alt+return",
    "input.delete.to.line.end": "none",
    "session.tab.next": "ctrl+tab",
    "session.tab.previous": "ctrl+shift+tab",
    "session.line.up": "ctrl+u",
    "session.line.down": "ctrl+d",
    "input.delete.word.backward": "ctrl+backspace",
    "agent.cycle": "tab"
  }
}
